{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "HeroRegistry.Infrastructure.Persistence": "Information"
      }
    }
  },
  "ApplicationInsights": {
    "SamplingRatio": 1.0
  },
  "Database": {
    "SlowCommandThresholdMs": 500
  },
  "AllowedHosts": "*"
}
