@HeroRegistry_Api_HostAddress = http://localhost:5103

### Smoke test endpoint (anonymous)
GET {{HeroRegistry_Api_HostAddress}}/api/v1/test
Accept: application/json

### OpenAPI document (Development only, anonymous)
GET {{HeroRegistry_Api_HostAddress}}/openapi/v1.json
Accept: application/json

### Health: readiness, includes SQL Server (Development only, anonymous)
GET {{HeroRegistry_Api_HostAddress}}/health

### Health: liveness (Development only, anonymous)
GET {{HeroRegistry_Api_HostAddress}}/alive

# Interactive API reference (open in a browser): {{HeroRegistry_Api_HostAddress}}/scalar

###############################################################################
# Auth (T09)
###############################################################################

### Log in as the seeded administrator; the token is reused below
# @name login
POST {{HeroRegistry_Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "Admin",
  "password": "Admin"
}

###
@token = {{login.response.body.$.accessToken}}

### Register a new regular user (anonymous) -> 201
POST {{HeroRegistry_Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "peter.parker",
  "email": "peter@dailybugle.com",
  "password": "Sp1der-Sense!"
}

### The signed-in user's profile -> 200 (401 without the token)
GET {{HeroRegistry_Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### Refresh the session (T09.1): send the hr_refresh cookie from the login response -> 200, new token + rotated cookie
# The cookie is Secure and Path=/api/auth: use the https profile so the client stores and sends it.
# Replaying an old cookie more than 30 s after it was rotated -> 401 auth.refresh_invalid (session revoked).
# @name refresh
POST {{HeroRegistry_Api_HostAddress}}/api/auth/refresh

### Log out (T09.1): revoke the session and delete the cookie -> 204 (a later refresh -> 401)
POST {{HeroRegistry_Api_HostAddress}}/api/auth/logout

###############################################################################
# Users (T09, AC11)
###############################################################################

### List users (administrators only) -> 200
GET {{HeroRegistry_Api_HostAddress}}/api/users
Authorization: Bearer {{token}}

### Update an account: your own, or any account as an administrator -> 200
PUT {{HeroRegistry_Api_HostAddress}}/api/users/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "spider.man",
  "email": "spidey@avengers.org"
}

### Soft-delete a user (administrators only, never yourself) -> 204
DELETE {{HeroRegistry_Api_HostAddress}}/api/users/2
Authorization: Bearer {{token}}

###############################################################################
# Heroes (T10). Uses the token from the login request above.
###############################################################################

### Search, sort and page: search matches name, first/last name, city or a superpower
GET {{HeroRegistry_Api_HostAddress}}/api/heroes?search=flight&page=1&pageSize=10&sortBy=PowerLevel&sortDirection=Descending
Authorization: Bearer {{token}}

### One hero -> 200 (404 if missing or deleted)
GET {{HeroRegistry_Api_HostAddress}}/api/heroes/1
Authorization: Bearer {{token}}

### Register a hero -> 201 with a Location header
# @name createHero
POST {{HeroRegistry_Api_HostAddress}}/api/heroes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "heroName": "Black Widow",
  "firstName": "Natasha",
  "lastName": "Romanoff",
  "birthDate": "1984-11-22",
  "email": "black.widow@heroregistry.com",
  "superpowers": ["Espionage", "Martial arts"],
  "powerLevel": 75,
  "address1": "1 Avengers Tower",
  "address2": null,
  "city": "Manhattan",
  "state": "NY",
  "zipCode": "10001"
}

###
@heroId = {{createHero.response.body.$.id}}

### Update the hero -> 200
PUT {{HeroRegistry_Api_HostAddress}}/api/heroes/{{heroId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "heroName": "Black Widow",
  "firstName": "Natasha",
  "lastName": "Romanoff",
  "birthDate": "1984-11-22",
  "email": "black.widow@heroregistry.com",
  "superpowers": ["Espionage", "Martial arts", "Marksmanship"],
  "powerLevel": 80,
  "address1": "1 Avengers Tower",
  "address2": "Floor 93",
  "city": "Manhattan",
  "state": "NY",
  "zipCode": "10001"
}

### Soft-delete the hero (administrators only) -> 204
DELETE {{HeroRegistry_Api_HostAddress}}/api/heroes/{{heroId}}
Authorization: Bearer {{token}}
