{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "ApplicationInsights": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning", //set to Information to see db queries
                "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
            },
            "enableDependencyTracking": true,
            "dependencyTrackingOptions": {
                "enableSqlCommandTextInstrumentation": true
            }
        }
    },
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "<use secrets>"
}
