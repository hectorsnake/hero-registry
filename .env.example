# Copy to .env (never committed) and replace the values marked REPLACE_ME before `docker compose up`.

# SQL Server "sa" password. SQL Server requires at least 8 characters from three of: uppercase,
# lowercase, digits and symbols. Do not use ';' (it would break the connection string).
SA_PASSWORD=REPLACE_ME

# JWT signing key: REQUIRED, at least 32 bytes. The API refuses to start without it.
# Generate one with:   openssl rand -base64 48
#   (PowerShell 7:     [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48)))
JWT__KEY=REPLACE_ME

# Application Insights (optional). Leave EMPTY to disable it. Never put a placeholder here:
# a non-empty, invalid value stops the API at startup.
APPLICATIONINSIGHTS_CONNECTION_STRING=
